# Configuration of the start-up prefetching study. run.sh reads this file.

# The pod that holds traces and runs every simulation, and where its data lives.
KX="kubectl exec -i -n deepanjm deepanjm-a100 -c work --"
POD_ROOT=/localdisk/deepanjm/isca-traces/startup-prefetch
POD_PY=/localdisk/deepanjm/agentic-stuff/assigner-venv/bin/python3          # numpy
POD_PY_LZ4=/localdisk/deepanjm/agentic-stuff/swebench-trace/tools-venv/bin/python3   # numpy + lz4
E2E_SCRIPTS=/localdisk/deepanjm/isca-traces/swe-bench-e2e/scripts          # trace_e2e.sh, e2e_post.py

# Benchmark: one SWE-bench task traced under DynamoRIO, every phase; native runs for timing.
TASK=django__django-13809
DR_RUN=dr1
DR_WINDOW=200000000          # instructions per traced window
DR_PERIOD=2000000000         # one window per period, per process, from its first instruction
NATIVE_TASKS="django__django-13809 psf__requests-1142 pydata__xarray-2905 sphinx-doc__sphinx-8459 sympy__sympy-11618"
NATIVE_RUNS=6                # per task
NATIVE_PARALLEL=3
NATIVE_CORES=8-95            # physical cores for native runs; simulations use the rest
SIM_CPUS=96-127,224-255

# Scarab: one build per branch, from these worktrees.
BASELINE_WT=/h/deepanjm/dejavu-wt/baseline
IDEAL_WT=/h/deepanjm/dejavu-wt/ideal-prefetching
JOBS=120

# Local results (the ideal-prefetching worktree holds every result).
RESULTS=/h/deepanjm/dejavu-wt/ideal-prefetching/results/startup-prefetch
MORE_TRACES=/localdisk/deepanjm/deadblock/traces              # W6: sampled DR runs of four other SWE-bench tasks
